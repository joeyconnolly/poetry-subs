---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400..800;1,400..800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
	</head>
	<body>
		<main>
			<slot />
		</main>
	</body>
</html>

<style is:global>
	:root {
		--bg: #fdfcf8; 
		--text: #111111;
		--muted: #555555;
		--border: #e5e3da; /* Subtle rule lines */
		--accent: #8b0000; 
	}
	body {
		background-color: var(--bg);
		color: var(--text);
		font-family: 'Inter', sans-serif;
		font-size: 14px; /* Reduced base size */
		margin: 0;
		display: flex;
		justify-content: center;
		line-height: 1.4;
	}
	main {
		width: 100%;
		max-width: 900px; /* Widened to fit more data on one line */
		padding: 2rem 1.5rem;
	}
	h1, h2, h3 {
		font-family: 'EB Garamond', serif;
		font-weight: 500;
		margin: 0;
	}
	a { color: inherit; text-decoration: none; transition: color 0.2s;}
	a:hover { color: var(--accent); }
</style>